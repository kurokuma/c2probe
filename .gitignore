# Rust build output
/target/
/dist/
/generated-probes/
/docs/*
!/docs/FIXES.md
!/docs/NSE_CONVERSION.md
!/docs/NSE_COVERAGE.md
!/docs/PERFORMANCE.md
!/docs/REVIEW.md
**/*.rs.bk
*.profraw
/coverage/
/tarpaulin-report.html

# Python tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
/.venv/
/venv/

# Scan output and captures
*.jsonl
*.csv
*.log
*.pcap
*.pcapng
*.sqlite
*.sqlite3
*.db
*.txt

# The result tree is pushed daily and published through GitHub Pages, so the
# scan output under it stays tracked. Everything else above still applies.
/result/**/*.jsonl
/result/**/*.csv
/result/**/*.txt
/result/**/*.html
/result/**/*.md

# Local target and exclusion lists
/targets*.txt
/exclusions*.txt
/blocklist*.txt

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Editors and operating systems
/.vscode/
/.idea/
/.vs/
*.suo
*.user
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*~

spec.md
result/**/SUMMARY.json
result/.nojekyll
result/overview.json
